<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Préparation de poste" Width="1280" Height="720" MinWidth="1100" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3" FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}">
  <!--
      Coquille de la fenêtre (format 16:9) : menu latéral (connexion, poste, une entrée par page)
      et zone de page (titre, contenu, Précédent / Suivant).
      Les pages de saisie sont construites par MainWindow.ps1 dans PageHost à partir du parcours
      (FastPrepare.Core, Get-WizardPage) ; les sections sont des fragments séparés (Xaml/Sections)
      rangés dans leur page selon leur enregistrement (SectionRegistry.ps1).
      Le récapitulatif (PageRecap) est la seule page décrite ici : il porte le journal et le
      seul bouton Lancer.
  -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Menu latéral -->
    <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="14,16,14,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Préparation de poste" FontSize="17" FontWeight="SemiBold"/>
          <Border Name="BdNet" CornerRadius="14" Padding="12,6" Margin="0,12,0,0" HorizontalAlignment="Left" Background="{StaticResource NetKoBackgroundBrush}">
            <StackPanel Orientation="Horizontal">
              <Ellipse Name="NetDot" Width="10" Height="10" Fill="{StaticResource NetKoDotBrush}" VerticalAlignment="Center"/>
              <TextBlock Name="TxtNet" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource NetKoTextBrush}" Text="Test de la connexion…"/>
            </StackPanel>
          </Border>
          <TextBlock Name="TxtPoste" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="Détection du poste…"/>
          <TextBlock Name="TxtOs" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
          <!-- Profil entreprise : réglages d'un client enregistrés sur la clé (profils\*.json), sans mot de passe. -->
          <TextBlock Style="{StaticResource Sub}" Margin="0,12,0,4" Text="Profil entreprise"/>
          <ComboBox Name="CmbProfile" Height="28" IsEditable="True" VerticalContentAlignment="Center" ToolTip="Choisir un profil pour pré-remplir les étapes, ou saisir un nom puis Enregistrer."/>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="6"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Name="BtnProfileSave" Grid.Column="0" Content="Enregistrer" Height="28" Style="{StaticResource Secondary}"/>
            <Button Name="BtnProfileNew" Grid.Column="2" Content="Nouveau" Height="28" Style="{StaticResource Secondary}"/>
          </Grid>
          <TextBlock Name="TxtProfileHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Les mots de passe ne sont jamais enregistrés."/>
          <Border Height="1" Background="#E0E0E0" Margin="0,12,0,10"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <Button Name="BtnReview" Content="Vérifier et lancer" Height="38" FontWeight="SemiBold" Style="{StaticResource Primary}"/>
          <Border Name="BdReal" Background="{StaticResource ErrorLightBrush}" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock Text="MODE RÉEL — le poste sera modifié" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource ErrorBrush}" FontWeight="SemiBold" FontSize="11.5"/>
          </Border>
          <Border Name="BdSimu" Background="{StaticResource WarningLightBrush}" CornerRadius="4" Padding="10,5" Margin="0,10,0,0">
            <TextBlock Text="MODE SIMULATION — aucune modification du poste" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" FontSize="11.5"/>
          </Border>
        </StackPanel>

        <!-- Entrées générées : les pages du parcours, puis (PnlNavSettings) les pages hors parcours. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <StackPanel Name="PnlNav"/>
            <Border Height="1" Background="#E0E0E0" Margin="0,6,0,6"/>
            <StackPanel Name="PnlNavSettings"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Zone de page -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="24,16,24,8">
        <TextBlock Name="TxtPageTitle" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Name="TxtPageSub" Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
      </StackPanel>

      <Grid Name="PageHost" Grid.Row="1" Margin="24,4,24,0">
        <!-- Récapitulatif : actions prévues, points bloquants, mémo ; journal et bouton Lancer. -->
        <Grid Name="PageRecap" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Name="BdProblems" Background="{StaticResource ErrorLightBrush}" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="6" Padding="16,10" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="À corriger avant de lancer" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}"/>
                  <TextBlock Name="TxtProblems" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Section}">
                <StackPanel>
                  <TextBlock Style="{StaticResource H2}" Text="Actions prévues"/>
                  <TextBlock Name="TxtPlanSummary" TextWrapping="Wrap" FontWeight="SemiBold"/>
                  <StackPanel Name="PnlPlan" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
              <!-- Mémo : actions manuelles hors outil (texte issu de config.ManualReminders) -->
              <Border Background="#FFF8D6" BorderBrush="#E8C84A" BorderThickness="1" CornerRadius="6" Padding="16,10" Margin="0,0,0,12">
                <TextBlock Name="TxtMemo" TextWrapping="Wrap" Foreground="#3D3200" FontSize="12.5"/>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Column="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <RichTextBox Name="RtbLog" Grid.Row="0" IsReadOnly="True" Background="{StaticResource LogBackgroundBrush}" Foreground="{StaticResource LogInfoBrush}"
                         FontFamily="Consolas" FontSize="12" BorderThickness="0" Padding="6" VerticalScrollBarVisibility="Auto"/>
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
              <Button Name="BtnGo" Content="Lancer" Height="44" FontSize="15" FontWeight="SemiBold" IsEnabled="False" Style="{StaticResource Primary}"/>
              <ProgressBar Name="PbRun" Height="4" Margin="0,6,0,0" Minimum="0" Maximum="1" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"/>
              <TextBlock Name="TxtGoHint" Style="{StaticResource Hint}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" Text="Grisé : détection du poste en cours"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>

      <!-- Pied : Précédent / Suivant -->
      <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="24,10">
        <DockPanel LastChildFill="False">
          <Button Name="BtnNext" DockPanel.Dock="Right" Content="Suivant →" Height="36" MinWidth="170" FontWeight="SemiBold" Style="{StaticResource Primary}"/>
          <Button Name="BtnPrev" DockPanel.Dock="Right" Content="← Précédent" Height="36" Width="120" Margin="0,0,10,0" Style="{StaticResource Secondary}"/>
          <TextBlock Name="TxtFootHint" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
