<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Section}">
  <StackPanel>
    <TextBlock Style="{StaticResource H2}" Text="Agent RMM et antivirus"/>
    <TextBlock Style="{StaticResource Sub}" Text="Lien de l'agent RMM (NinjaOne .msi, Datto RMM .exe)"/>
    <TextBox Name="TxtRmmUrl" Height="28" Padding="6,0" VerticalContentAlignment="Center" MaxLength="2048"/>
    <TextBlock Name="TxtRmmHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,10"/>
    <TextBlock Style="{StaticResource Sub}" Text="Lien de l'antivirus (Bitdefender, ESET)"/>
    <TextBox Name="TxtAvUrl" Height="28" Padding="6,0" VerticalContentAlignment="Center" MaxLength="2048"/>
    <TextBlock Name="TxtAvHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel>
</Border>
