<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Section}">
  <StackPanel>
    <TextBlock Style="{StaticResource H2}" Text="Rappel : renommage du poste"/>
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="Nom actuel" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <TextBlock Name="TxtComputerName" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Text="Détection en cours…"/>
      <Border Name="BdDefaultName" Background="{StaticResource WarningLightBrush}" CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock Text="Nom par défaut de Windows" FontSize="11.5" Foreground="{StaticResource WarningBrush}"/>
      </Border>
    </StackPanel>
    <TextBlock Name="TxtComputerNameHint" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
  </StackPanel>
</Border>
