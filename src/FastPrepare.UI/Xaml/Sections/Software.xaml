<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Section}">
  <StackPanel>
    <TextBlock Style="{StaticResource H2}" Text="Installation logiciels"/>
    <!-- Cases générées depuis le catalogue software.json (page Catalogue logiciels) -->
    <StackPanel Name="PnlSoftware"/>
    <TextBlock Name="TxtSoftwareNone" Style="{StaticResource Hint}" Visibility="Collapsed"
               Text="Aucun logiciel au catalogue : ajoutez-en dans la page Catalogue logiciels."/>
  </StackPanel>
</Border>
