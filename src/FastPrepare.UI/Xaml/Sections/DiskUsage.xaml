<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Section}">
  <!--
      Analyse de disque (page hors parcours, lecture seule) : en haut l'arborescence triée par
      taille et les types de fichiers, en bas la carte des tailles (treemap). Les trois vues sont
      liées : un clic dans l'une sélectionne dans les autres.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="5*" MinHeight="120"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="4*" MinHeight="110"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Choix de la cible et commandes -->
    <DockPanel Grid.Row="0" LastChildFill="True">
      <TextBlock DockPanel.Dock="Left" Text="Disque ou dossier" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
      <ComboBox Name="CmbDiskTarget" DockPanel.Dock="Left" Width="300" Height="30" IsEditable="True" VerticalContentAlignment="Center"
                ToolTip="Choisir un disque, ou saisir le chemin d'un dossier."/>
      <Button Name="BtnDiskScan" DockPanel.Dock="Left" Content="Analyser" Width="110" Height="30" Margin="10,0,0,0" FontWeight="SemiBold" Style="{StaticResource Primary}"/>
      <Button Name="BtnDiskStop" DockPanel.Dock="Left" Content="Arrêter" Width="90" Height="30" Margin="8,0,0,0" IsEnabled="False" Style="{StaticResource Secondary}"/>
      <Button Name="BtnDiskOpen" DockPanel.Dock="Right" Content="Ouvrir dans l'Explorateur" Width="190" Height="30" Margin="10,0,0,0" IsEnabled="False" Style="{StaticResource Secondary}"/>
      <Border/>
    </DockPanel>
    <StackPanel Grid.Row="1" Margin="0,8,0,0">
      <TextBlock Name="TxtDiskStatus" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                 Text="Choisir un disque puis Analyser. Rien n'est modifié sur le poste. Les tailles sont celles des fichiers (taille logique)."/>
      <ProgressBar Name="PbDisk" Height="3" Margin="0,6,0,0" IsIndeterminate="False" Foreground="{StaticResource AccentBrush}" Visibility="Hidden"/>
    </StackPanel>

    <!-- Arborescence et types de fichiers -->
    <Grid Grid.Row="2" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="12*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="8*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#F7F7F7" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="8,5,26,5">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="126"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="70"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource Sub}" Margin="0" Text="Nom"/>
              <TextBlock Grid.Column="1" Style="{StaticResource Sub}" Margin="0" Text="Part du parent"/>
              <TextBlock Grid.Column="2" Style="{StaticResource Sub}" Margin="0" TextAlignment="Right" Text="Taille"/>
              <TextBlock Grid.Column="3" Style="{StaticResource Sub}" Margin="0" TextAlignment="Right" Text="Fichiers"/>
            </Grid>
          </Border>
          <ListBox Name="LstDiskTree" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                   VirtualizingStackPanel.IsVirtualizing="True"/>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#F7F7F7" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="8,5,26,5">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="64"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource Sub}" Margin="0" Text="Type de fichier"/>
              <TextBlock Grid.Column="1" Style="{StaticResource Sub}" Margin="0" TextAlignment="Right" Text="Part"/>
              <TextBlock Grid.Column="2" Style="{StaticResource Sub}" Margin="0" TextAlignment="Right" Text="Taille"/>
              <TextBlock Grid.Column="3" Style="{StaticResource Sub}" Margin="0" TextAlignment="Right" Text="Fichiers"/>
            </Grid>
          </Border>
          <ListBox Name="LstDiskExt" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                   VirtualizingStackPanel.IsVirtualizing="True"/>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Carte des tailles -->
    <Border Grid.Row="4" Background="{StaticResource DiskMapBackgroundBrush}" CornerRadius="4" Padding="2" ClipToBounds="True">
      <Grid Name="GrdDiskMap" Background="Transparent" Cursor="Hand">
        <Image Name="ImgDiskMap" Stretch="Fill"/>
        <Image Name="ImgDiskOverlay" Stretch="Fill" IsHitTestVisible="False"/>
        <TextBlock Name="TxtDiskMapEmpty" Foreground="#B8C0CA" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"
                   Text="La carte des tailles s'affiche ici après l'analyse : une tuile par fichier ou groupe de fichiers, de surface proportionnelle à sa taille."/>
      </Grid>
    </Border>
    <TextBlock Name="TxtDiskHover" Grid.Row="5" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="2,6,0,0"
               Text="Survoler la carte pour identifier une tuile ; cliquer pour la retrouver dans l'arborescence."/>
  </Grid>
</Border>
