<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Section}">
  <StackPanel>
    <TextBlock Style="{StaticResource H2}" Text="Sessions locales à créer"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="24"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Saisie d'une session -->
      <StackPanel Grid.Column="0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom de session" VerticalAlignment="Center"/>
          <TextBox Name="TxtNewName" Grid.Row="0" Grid.Column="1" Height="28" Margin="0,2" Padding="6,0" VerticalContentAlignment="Center" MaxLength="20"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Nom complet (facultatif)" VerticalAlignment="Center"/>
          <TextBox Name="TxtNewFullName" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,2" Padding="6,0" VerticalContentAlignment="Center" MaxLength="256"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Description (facultatif)" VerticalAlignment="Center"/>
          <TextBox Name="TxtNewDescription" Grid.Row="2" Grid.Column="1" Height="28" Margin="0,2" Padding="6,0" VerticalContentAlignment="Center" MaxLength="48"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Groupe" VerticalAlignment="Center"/>
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <RadioButton Name="RbNewUser" GroupName="NewAccountGroup" Content="Utilisateurs" IsChecked="True" Margin="0,0,18,0"/>
            <RadioButton Name="RbNewAdmin" GroupName="NewAccountGroup" Content="Administrateurs"/>
          </StackPanel>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="Mot de passe" VerticalAlignment="Center"/>
          <PasswordBox Name="PwdNew" Grid.Row="4" Grid.Column="1" Height="28" Margin="0,2" Padding="6,0" VerticalContentAlignment="Center" MaxLength="127"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="Confirmation" VerticalAlignment="Center"/>
          <PasswordBox Name="PwdNewConfirm" Grid.Row="5" Grid.Column="1" Height="28" Margin="0,2" Padding="6,0" VerticalContentAlignment="Center" MaxLength="127"/>
        </Grid>
        <CheckBox Name="ChkNewNeverExpires" Margin="0,8,0,3" Content="Le mot de passe n'expire jamais"/>
        <CheckBox Name="ChkNewMustChange" Margin="0,0,0,3" Content="L'utilisateur doit changer le mot de passe à la première ouverture de session"/>
        <CheckBox Name="ChkNewCannotChange" Margin="0,0,0,3" Content="L'utilisateur ne peut pas changer le mot de passe"/>
        <CheckBox Name="ChkNewDisabled" Content="Le compte est désactivé"/>
        <Button Name="BtnNewAdd" Content="Ajouter à la liste" Height="32" Width="170" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource Secondary}"/>
        <TextBlock Name="TxtNewHint" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
      </StackPanel>

      <!-- Sessions qui seront créées -->
      <StackPanel Grid.Column="2">
        <TextBlock Style="{StaticResource Sub}" Text="Sessions qui seront créées"/>
        <Border BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4" Margin="0,6,0,0">
          <StackPanel>
            <StackPanel Name="PnlNewAccounts"/>
            <TextBlock Name="TxtNewNone" Style="{StaticResource Hint}" Margin="10,8" Text="Aucune session à créer."/>
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                   Text="Les mots de passe sont saisis à chaque préparation : ils ne sont écrits ni sur la clé, ni dans un profil, ni dans le journal."/>
      </StackPanel>
    </Grid>
  </StackPanel>
</Border>
