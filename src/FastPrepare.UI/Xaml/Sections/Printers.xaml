<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Section}">
  <StackPanel>
    <TextBlock Style="{StaticResource H2}" Text="Imprimantes IP"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="170"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Sub}" Text="Nom de l'imprimante"/>
      <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Sub}" Text="Adresse IP"/>
      <TextBox Name="TxtPrinterName" Grid.Row="1" Grid.Column="0" Height="28" Padding="6,0" VerticalContentAlignment="Center" MaxLength="220"/>
      <TextBox Name="TxtPrinterAddress" Grid.Row="1" Grid.Column="2" Height="28" Padding="6,0" VerticalContentAlignment="Center" MaxLength="255"/>
    </Grid>
    <TextBlock Name="TxtPrinterFolder" Style="{StaticResource Sub}" Margin="0,8,0,4" Text="Pilote (.inf)"/>
    <DockPanel>
      <Button Name="BtnPrinterScan" DockPanel.Dock="Right" Content="Actualiser" Height="28" Width="90" Margin="8,0,0,0" Style="{StaticResource Secondary}"/>
      <ComboBox Name="CmbPrinterInf" Height="28" VerticalContentAlignment="Center"/>
    </DockPanel>
    <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,4" Text="Modèle (nom du pilote, tel qu'écrit dans le fichier .inf)"/>
    <ComboBox Name="CmbPrinterModel" Height="28" VerticalContentAlignment="Center" IsEditable="True"/>
    <Button Name="BtnPrinterAdd" Content="Ajouter à la liste" Height="32" Width="170" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource Secondary}"/>
    <TextBlock Name="TxtPrinterHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,8"/>
    <Border BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4">
      <StackPanel>
        <StackPanel Name="PnlPrinters"/>
        <TextBlock Name="TxtPrintersNone" Style="{StaticResource Hint}" Margin="10,8" Text="Aucune imprimante à installer."/>
      </StackPanel>
    </Border>
  </StackPanel>
</Border>
