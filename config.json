{
  "ConfigVersion": 3,

  "Execution": {
    "DefaultMode": "Real",
    "CacheFolder": "%ProgramData%\\FastPrepare\\cache"
  },

  "Logging": {
    "Folder": "logs"
  },

  "Connectivity": {
    "TestUrl": "http://www.msftconnecttest.com/connecttest.txt",
    "Expected": "Microsoft Connect Test",
    "IntervalSeconds": 5,
    "TimeoutSeconds": 4,
    "RetrySeconds": 5,
    "GraceSeconds": 60
  },

  "Winget": {
    "FamilyName": "Microsoft.DesktopAppInstaller_8wekyb3d8bbwe",
    "OfflineBundle": "packages\\Microsoft.DesktopAppInstaller.msixbundle",
    "SourcePackage": {
      "Url": "https://cdn.winget.microsoft.com/cache/source.msix",
      "ExpectedSigner": "CN=Microsoft Corporation"
    }
  },

  "Utilities": {
    "dell": {
      "Label": "Dell",
      "Subtitle": "Command Update",
      "Tool": "Dell Command Update",
      "Logo": "dell.png",
      "ManufacturerPattern": "Dell",
      "Install": [
        { "Type": "winget", "Id": "Dell.CommandUpdate.Universal", "Source": "winget" }
      ],
      "DotNet": [
        { "DcuVersion": "5.7.0", "WingetId": "Microsoft.DotNet.DesktopRuntime.8", "MinVersion": "8.0.8", "MaxVersion": "8.0.25" },
        { "DcuVersion": "5.7.1", "WingetId": "Microsoft.DotNet.DesktopRuntime.10", "MinVersion": "10.0.8", "MaxVersion": "" }
      ],
      "Update": {
        "FilePath": "%ProgramFiles%\\Dell\\CommandUpdate\\dcu-cli.exe",
        "Arguments": "/applyUpdates -reboot=disable",
        "SuccessExitCodes": [0, 500],
        "RebootExitCodes": [1, 5]
      }
    },
    "hp": {
      "Label": "HP",
      "Subtitle": "Image Assistant",
      "Tool": "HP Image Assistant",
      "Logo": "hp.png",
      "ManufacturerPattern": "HP|Hewlett",
      "Install": [
        { "Type": "winget", "Id": "HP.ImageAssistant", "Source": "winget" }
      ],
      "Update": {
        "FilePath": "HPImageAssistant.exe",
        "Arguments": "/Operation:Analyze /Action:Install /Silent",
        "SuccessExitCodes": [0, 256, 257],
        "RebootExitCodes": [3010],
        "ExitCodeMessages": {
          "3020": "échec de l'installation d'une ou plusieurs SoftPaq",
          "4096": "plateforme non prise en charge par HP Image Assistant",
          "4097": "paramètres invalides",
          "4098": "pas de connexion internet",
          "4104": "aucun système d'exploitation pris en charge pour ce poste",
          "8192": "opération en échec",
          "8199": "échec du téléchargement d'une SoftPaq",
          "16384": "fichier de référence HP illisible",
          "16385": "fichier de référence HP invalide",
          "16386": "fichier de référence HP non pris en charge pour cette version de Windows"
        }
      }
    },
    "lenovo": {
      "Label": "Lenovo",
      "Subtitle": "Commercial Vantage",
      "Tool": "Commercial Vantage + SU Helper",
      "Logo": "lenovo.png",
      "ManufacturerPattern": "Lenovo",
      "Install": [
        { "Type": "download", "Url": "https://download.lenovo.com/pccbbs/thinkvantage_en/metroapps/Vantage/LenovoCommercialVantage_20.2606.24.0.20260917014203.zip", "FileName": "LenovoCommercialVantage.zip", "Run": "VantageInstaller.exe", "Arguments": "Install -Vantage -SuHelper", "Sha256": "", "ExpectedSigner": "Lenovo" }
      ],
      "Update": {
        "FilePath": "%ProgramFiles%\\Lenovo\\SUHelper\\suhelper.exe",
        "Arguments": "-autoupdate -packagetype 1,2,3,4 -reboottype 0,3,5 -noreboot",
        "SuccessExitCodes": [0],
        "ExitCodeMessages": {
          "1": "paramètre invalide",
          "2": "une session de mise à jour Commercial Vantage est déjà en cours",
          "3": "erreur inattendue (détails dans l'Observateur d'événements)"
        },
        "Asynchronous": true,
        "Notice": "Mises à jour Lenovo lancées par Commercial Vantage : elles se poursuivent en arrière-plan. Attendre leur fin (Commercial Vantage › Mise à jour du système) avant le redémarrage final."
      }
    },
    "fujitsu": {
      "Label": "Fujitsu",
      "Subtitle": "DeskUpdate",
      "Tool": "DeskUpdate",
      "Logo": "fujitsu.png",
      "ManufacturerPattern": "Fujitsu",
      "Install": [
        { "Type": "winget", "Id": "FujitsuClientComputingLimited.DeskUpdate", "Source": "winget" }
      ],
      "Update": {
        "FilePath": "ducmd.exe",
        "Arguments": "/WEB /DRV /BIOS",
        "SuccessExitCodes": [0]
      }
    }
  },

  "Office": {
    "OdtSetupUrl": "https://officecdn.microsoft.com/pr/wsus/setup.exe",
    "OdtFolder": "C:\\ODT",
    "Architecture": "64",
    "Language": "MatchOS",
    "Editions": [
      { "Key": "O365", "Label": "365 Apps for Business", "Name": "Microsoft 365 Apps for Business", "ProductId": "O365BusinessRetail", "NoTeamsProductId": "O365BusinessEEANoTeamsRetail", "Channel": "MonthlyEnterprise" },
      { "Key": "LTSC2024", "Label": "LTSC Pro Plus 2024", "Name": "Office LTSC Professional Plus 2024", "ProductId": "ProPlus2024Volume", "Channel": "PerpetualVL2024" },
      { "Key": "STD2019", "Label": "Standard 2019", "Name": "Office Standard 2019", "ProductId": "Standard2019Volume", "Channel": "PerpetualVL2019" },
      { "Key": "PP2019", "Label": "Pro Plus 2019", "Name": "Office Professional Plus 2019", "ProductId": "ProPlus2019Volume", "Channel": "PerpetualVL2019" }
    ],
    "OptionalApps": [
      { "Id": "OutlookForWindows", "Label": "Nouvel Outlook" },
      { "Id": "Outlook", "Label": "Outlook classique" },
      { "Id": "OneDrive", "Label": "OneDrive" }
    ]
  },

  "SoftwareCatalog": "software.json",

  "Power": {
    "MonitorTimeoutMinutes": 5,
    "StandbyTimeoutMinutes": 15,
    "ApplyOnBattery": true
  },

  "Printers": {
    "DriverFolder": "C:\\Drivers"
  },

  "NewLocalAccount": {
    "Administrator": false,
    "PasswordNeverExpires": true,
    "MustChangePassword": false
  },

  "ManualReminders": [
    "Renommage du poste puis redémarrage (avant l'outil)",
    "Chiffrement BitLocker",
    "Connexion du compte 365",
    "Redémarrage final"
  ]
}
